# --- Django Core Settings ---
DJANGO_SECRET_KEY=change-me-to-a-very-long-secure-random-string-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.yourdomain.com,localhost,127.0.0.1

# --- CORS Settings ---
# URL of your frontend application
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Database Settings (PostgreSQL is recommended for production) ---
# If these are left blank or omitted, Django will fallback to local SQLite
DB_NAME=orbitflow
DB_USER=postgres
DB_PASSWORD=your-secure-db-password
DB_HOST=localhost
DB_PORT=5432

# --- Redis & Celery Settings ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
